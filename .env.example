# Copiar a .env (gitignoreado). Sin secretos en este archivo.
# Interfaces donde escuchar, separadas por coma (nunca 0.0.0.0).
HUB_HOST=127.0.0.1
SENTINEL_API_PORT=4710
SENTINEL_WEB_PORT=4711
# Inferencia apagada. "true" llama a SAM 3.1 (pago): exige consentimiento explícito,
# MODEL_API_KEY y META_MAX_REQUESTS (1-200); sin alguno, la API no arranca.
META_API_ENABLED=false
# MODEL_API_KEY=
# META_MAX_REQUESTS=
# Muse Spark 1.3 (explicación advisory, sólo endurece; pago): apagado. "true" exige
# consentimiento explícito, META_API_ENABLED=true, MODEL_API_KEY y
# META_SPARK_MAX_REQUESTS (1-200, ledger propio); sin alguno, la API no arranca.
# META_SPARK_ENABLED=false
# META_SPARK_MAX_REQUESTS=
FRESHNESS_TTL_MS=2000
INFERENCE_TIMEOUT_MS=5000
# Muse Spark corre después de la decisión del PLC; su timeout no la frena.
SPARK_TIMEOUT_MS=20000
FRAME_TIMEOUT_MS=8000
# Evidencias locales (gitignoreado). Vacío = <repo>/evidence
EVIDENCE_DIR=
EVIDENCE_MAX_FRAMES=500
